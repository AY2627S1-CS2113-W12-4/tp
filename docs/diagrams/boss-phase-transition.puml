@startuml
' Scope: boss phase 1 is defeated; evaluation, UI and persistence calls are omitted.
hide footbox
skinparam monochrome true
skinparam defaultFontName Arial
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 14
skinparam sequenceMessageAlign center
participant "game:\nGamePlayState" as game
participant "phase1:\nCombatEncounter" as phase1
participant "outcome:\nEncounterOutcome" as outcome
participant "EnemyFactory" as factory <<class>>

activate game
note over game : Inside finishAttempt(...).
game -> phase1 : submitTypingResult(...)
activate phase1
note right of phase1
  Enemy reaches 0 HP.
  No retaliation.
end note
return

game -> phase1 : getIsCompleted()
activate phase1
return true
game -> phase1 : getEncounterOutcome()
activate phase1
return outcome
game -> outcome : getIsVictory()
activate outcome
return true

game -> game : advanceAfterVictory()
activate game
note over game : bossPhase becomes 2.
game -> game : startBossPhase()
activate game
game -> factory : createBossPhase(2)
activate factory
return enemy

create participant "phase2:\nCombatEncounter" as phase2
game -> phase2 : CombatEncounter(...)
activate phase2
return
game -> phase2 : begin()
activate phase2
return
return
return true

note over game, phase2
  Same player, prompt factory and difficulty.
  Phase 2: 70 HP; excess damage is discarded.
  No healing or transition attack.
end note
deactivate game
@enduml
