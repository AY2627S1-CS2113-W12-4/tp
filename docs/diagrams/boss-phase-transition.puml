@startuml
' Focus: a lethal attack against boss phase 1. Nonlethal and defeat paths are omitted.
hide footbox
skinparam monochrome true
skinparam shadowing false
participant "game:GamePlayState" as game
participant "phase1:CombatEncounter" as phase1
participant "EnemyFactory" as factory
activate game
game -> phase1 : submitTypingResult(result)
activate phase1
note right of phase1
  Resolve attack; enemy reaches 0 HP.
  Complete victory and return before retaliation.
end note
phase1 --> game
deactivate phase1
game -> phase1 : getIsCompleted()
activate phase1
phase1 --> game : true
deactivate phase1
game -> phase1 : getEncounterOutcome()
activate phase1
phase1 --> game : victory outcome
deactivate phase1
game -> game : advanceAfterVictory(); bossPhase = 2
activate game
game -> factory : createBossPhase(2)
activate factory
factory --> game : fresh enemy (70 HP, attack 20)
deactivate factory
create participant "phase2:CombatEncounter" as phase2
game -> phase2 : new CombatEncounter(samePlayer, enemy, ui, challengeFactory)
game -> phase2 : begin()
activate phase2
phase2 --> game : ready for player turn
deactivate phase2
deactivate game
note over game, phase2
  Player HP carries unchanged. No healing, overflow damage or transition attack.
  Phase 2 starts at full HP; defeating phase 1 does not win the run.
end note
deactivate game
@enduml
