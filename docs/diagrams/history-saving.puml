@startuml
hide footbox
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam backgroundColor white
skinparam defaultFontSize 14
skinparam sequenceMessageAlign center
title Save one response before resolving its encounter

participant "game:\nGamePlayState" as game
participant "history:\nSaveStore" as history
participant "best:\nLeaderboardStore" as best
participant "encounter:\nCombatEncounter" as encounter
participant "event:\nEventEncounter" as event

note over game, encounter
  Scope: finishAttempt(...) after evaluation.
  File I/O internals and validation are omitted.
end note
activate game
game -> history : save(result)
activate history
history -> history : loadHighScore()
activate history
history -> best : load()
activate best
best --> history : previousBest
deactivate best
opt no saved high score
  history -> history : load()
  activate history
  history --> history : records
  deactivate history
  opt records contain a best attempt
    note right of history
      Select previousBest by WPM,
      then accuracy.
    end note
    history -> best : saveIfHigher(previousBest)
    activate best
    best --> history
    deactivate best
  end
end
history --> history : previousBest
deactivate history
history -> best : saveIfHigher(candidate)
activate best
best --> history
deactivate best
note right of history
  Append the result to existing history
  and retain the latest ten entries.
end note
history -> history : writeSafely(...)
activate history
history --> history
deactivate history
history --> game
deactivate history
alt selected encounter is combat
  game -> encounter : submitTypingResult(result)
  activate encounter
  encounter --> game
  deactivate encounter
else selected encounter is an event
  note over game, event
    Overdue: response is empty.
    Otherwise: submitted text.
  end note
  game -> event : submitAnswer(...)
  activate event
  event --> game : nextChallenge
  deactivate event
  game -> game : activateEventChallenge(...)
  activate game
  note over game, history
    A non-null challenge starts
    the next event stage.
  end note
  game --> game
  deactivate game
end
deactivate game
note over game, best
  High score and history are separate writes.
  IOException is reported; response resolution continues.
  Progression and run autosaves are omitted.
end note
@enduml
