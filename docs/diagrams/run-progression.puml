@startuml
' Scope: references during active gameplay and the dependency that creates opponents.
!pragma layout smetana
left to right direction
skinparam monochrome true
skinparam defaultFontName Arial
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
hide empty members
hide circle

class GamePlayState {
  -scenarioIndex : int
  -bossPhase : int
  -startScenario() : void
  -startBossPhase() : void
  -advanceAfterVictory() : boolean
}
class Player {
  +getHealth() : int
}
class CombatEncounter {
  +begin() : void
  +preparePlayerTurn(...) : TypingChallenge
  +submitTypingResult(...) : void
}
class Enemy {
  +getHealth() : int
}
class EnemyFactory {
  {static} +createRandomEnemy(...) : Enemy
  {static} +createBossPhase(...) : Enemy
}

GamePlayState --> "1\nplayer" Player
GamePlayState --> "1\nencounter" CombatEncounter
GamePlayState ..> EnemyFactory
CombatEncounter --> "1\nplayer" Player
CombatEncounter --> "1\nenemy" Enemy
EnemyFactory ..> Enemy : <<create>>

note bottom of GamePlayState
  bossPhase = 0 in regular scenarios;
  1 or 2 in the final boss encounter.
end note
@enduml
