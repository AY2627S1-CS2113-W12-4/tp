@startuml
' Focus: active-run references and creation dependencies.
left to right direction
skinparam monochrome true
skinparam shadowing false
class GamePlayState {
  -scenarioIndex : int
  -bossPhase : int
  -startScenario()
  -startBossPhase()
  -advanceAfterVictory()
}
class Player {
  +getHealth() : int
}
class CombatEncounter {
  +begin()
  +preparePlayerTurn(skill)
  +submitTypingResult(result)
}
class Enemy {
  +getHealth() : int
}
class EnemyFactory {
  {static} +createRandomEnemy(random, scenarioNumber)
  {static} +createBossPhase(phase)
}
GamePlayState --> "1" Player : player
GamePlayState --> "1" CombatEncounter : encounter
GamePlayState ..> EnemyFactory : calls
CombatEncounter --> "1" Player : player
CombatEncounter --> "1" Enemy : enemy
EnemyFactory ..> Enemy : creates
note bottom of GamePlayState
  bossPhase = 0 for regular scenarios;
  1 or 2 for the boss.
end note
@enduml
